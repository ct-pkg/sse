namespace sse;

#include <stdarg.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

/*
 * Allocation funnel. Every heap operation goes through two internal function
 * pointers, defaulting to malloc/free. A test harness can swap in a failing
 * allocator through sse_test_alloc_hook(): that function is not `pub`, so it
 * is absent from the generated header, and --lib builds emit it as static.
 * The failure count lives in the test stub, not here; production never
 * installs a stub and never runs test code.
 */
typedef void *(*SseAllocFn)(size_t);
typedef void (*SseFreeFn)(void *);

static void *sse_default_alloc(size_t n)
{
    return malloc(n);
}

static void sse_default_free(void *p)
{
    free(p);
}

static SseAllocFn *sse_alloc_slot(void)
{
    static SseAllocFn fn = sse_default_alloc;
    return &fn;
}

static SseFreeFn *sse_free_slot(void)
{
    static SseFreeFn fn = sse_default_free;
    return &fn;
}

static void *sse_mem_alloc(size_t n)
{
    return (*sse_alloc_slot())(n);
}

static void sse_mem_free(void *p)
{
    if (p == 0) return;
    (*sse_free_slot())(p);
}

/* Test-only injection point; see the comment above. */
void sse_test_alloc_hook(SseAllocFn alloc_fn, SseFreeFn free_fn)
{
    if (alloc_fn != 0) *sse_alloc_slot() = alloc_fn;
    if (free_fn != 0) *sse_free_slot() = free_fn;
}

/*
 * SseEvent is a borrow view owned by the parser. Its fields stay valid until
 * the callback returns, and no longer than the next feed / finish / reset /
 * delete on the same parser. To keep an event, use sse_event_copy().
 */
pub struct SseEvent {
    char *event;
    char *data;
    int data_len;
    char *id;
    int retry;
}

impl SseEvent {
    pub int has_id() {
        return self->id != 0;
    }
    pub int has_retry() {
        return self->retry >= 0;
    }
    pub int is_message() {
        if (self->event == 0) return 1;
        return strcmp(self->event, "message") == 0;
    }
}

pub typedef int (*SseEventCb)(SseEvent *ev, void *ud);

pub struct SseParser {
    char *line_buf;
    int line_len;
    int line_cap;
    char *data_buf;
    int data_len;
    int data_cap;
    char *event_buf;
    int event_len;
    int event_cap;
    char *id_buf;
    int id_len;
    int id_cap;
    int id_valid;
    int retry;
    int retry_valid;
    int has_data;
    int error;
    int err_code;
    int in_callback;
    int finished;
    int saw_cr;
    int max_line_bytes;
    int bom_state;
    char bom_buf[3];
    int bom_len;
    char error_msg[128];
    SseEventCb cb;
    void *ud;
    SseEvent current;
} use Drop;

pub typedef SseParser *(*SseCtor)(void);

/*
 * A value-returning registry host. Methods return the host by value so the
 * caller can land the result on a variable:
 *
 *   SseRegistry reg = base.reg("parser", sse_parser_new);
 *   SseParser *p = reg.make("parser");
 *
 * error(): 0 ok, 1 not found, 2 duplicate (first registration wins), 3 full.
 * name strings are borrowed, not copied; use string literals or static storage.
 */
pub struct SseRegistry {
    int count;
    int err;
    char *names[8];
    SseCtor fns[8];
};

impl SseRegistry {
    int find(char *name) {
        int i = 0;
        while (i < self->count) {
            if (strcmp(self->names[i], name) == 0) return i;
            i = i + 1;
        }
        return -1;
    }

    pub SseRegistry init() {
        int i = 0;
        self->count = 0;
        self->err = 0;
        while (i < 8) {
            self->names[i] = 0;
            self->fns[i] = 0;
            i = i + 1;
        }
        return *self;
    }

    pub SseRegistry reg(char *name, SseCtor fn) {
        if (self->find(name) >= 0) {
            self->err = 2;
            return *self;
        }
        if (self->count >= 8) {
            self->err = 3;
            return *self;
        }
        self->names[self->count] = name;
        self->fns[self->count] = fn;
        self->count = self->count + 1;
        self->err = 0;
        return *self;
    }

    pub SseParser *make(char *name) {
        int i = self->find(name);
        if (i < 0) {
            self->err = 1;
            return 0;
        }
        self->err = 0;
        return self->fns[i]();
    }

    pub int error() {
        return self->err;
    }

    pub int size() {
        return self->count;
    }
}

/*
 * Record a fatal error and answer -1 for the caller's return path.
 * Codes: 0 none, 1 protocol/limit, 2 out of memory, 3 callback aborted,
 * 4 reentrant call, 5 parser finished.
 */
static int sse_set_error_code(SseParser *p, int code, char *fmt, ...)
{
    va_list ap;
    va_start(ap, fmt);
    vsnprintf(p->error_msg, sizeof(p->error_msg), fmt, ap);
    va_end(ap);
    p->error = 1;
    p->err_code = code;
    return -1;
}

static int sse_reserve(char **buf, int *cap, int need)
{
    char *nb;
    int nc;
    if (need <= *cap) return 0;
    nc = *cap > 0 ? *cap : 32;
    while (nc < need) nc = nc * 2;
    nb = sse_mem_alloc((size_t)nc);
    if (nb == 0) return -1;
    if (*buf != 0 && *cap > 0) {
        memcpy(nb, *buf, (size_t)*cap);
        sse_mem_free(*buf);
    }
    *buf = nb;
    *cap = nc;
    return 0;
}

static int sse_push_char(char **buf, int *len, int *cap, char c)
{
    if (sse_reserve(buf, cap, *len + 1) < 0) return -1;
    (*buf)[*len] = c;
    *len = *len + 1;
    return 0;
}

static int sse_push_str(char **buf, int *len, int *cap, char *s, int n)
{
    if (n <= 0) return 0;
    if (sse_reserve(buf, cap, *len + n) < 0) return -1;
    memcpy(*buf + *len, s, (size_t)n);
    *len = *len + n;
    return 0;
}

static int sse_terminate(char **buf, int *cap, int len)
{
    if (sse_reserve(buf, cap, len + 1) < 0) return -1;
    (*buf)[len] = 0;
    return 0;
}

impl SseParser {
    /* Helpers first: impl methods have no forward declarations. */
    int line_limit() {
        if (self->max_line_bytes > 0) return self->max_line_bytes;
        return 65536;
    }

    /* The event callback runs with in_callback set. Mutating the same parser
     * from inside it is rejected instead of leaving half-parsed state. */
    int reject_reentrant() {
        if (self->in_callback == 0) return 0;
        return sse_set_error_code(self, 4, "reentrant call is not allowed");
    }

    int dispatch_event() {
        int r = 0;

        if (self->has_data == 0) {
            self->event_len = 0;
            return 0;
        }
        if (self->data_len > 0 && self->data_buf[self->data_len - 1] == '\n')
            self->data_len = self->data_len - 1;
        if (self->data_buf != 0) self->data_buf[self->data_len] = 0;

        self->current.event = self->event_len > 0
                              ? self->event_buf
                              : "message";
        self->current.data = self->data_buf;
        self->current.data_len = self->data_len;
        self->current.id = self->id_valid != 0 ? self->id_buf : 0;
        self->current.retry = self->retry_valid != 0 ? self->retry : -1;

        if (self->cb != 0) {
            self->in_callback = 1;
            r = self->cb(&self->current, self->ud);
            self->in_callback = 0;
        }

        self->data_len = 0;
        self->event_len = 0;
        self->has_data = 0;

        if (self->error) return -1;
        if (r != 0) return sse_set_error_code(self, 3, "callback aborted");
        return 1;
    }

    int handle_field(char *field, int field_len, char *value, int value_len) {
        int i;
        int ok;
        long v;

        if (field_len == 4 && strncmp(field, "data", 4) == 0) {
            if (sse_push_str(&self->data_buf, &self->data_len,
                             &self->data_cap, value, value_len) < 0)
                return sse_set_error_code(self, 2, "out of memory");
            if (sse_push_char(&self->data_buf, &self->data_len,
                              &self->data_cap, '\n') < 0)
                return sse_set_error_code(self, 2, "out of memory");
            self->has_data = 1;
            return 0;
        }

        if (field_len == 5 && strncmp(field, "event", 5) == 0) {
            self->event_len = 0;
            if (value_len > 0) {
                if (sse_push_str(&self->event_buf, &self->event_len,
                                 &self->event_cap, value, value_len) < 0)
                    return sse_set_error_code(self, 2, "out of memory");
                if (sse_terminate(&self->event_buf, &self->event_cap,
                                  self->event_len) < 0)
                    return sse_set_error_code(self, 2, "out of memory");
            }
            return 0;
        }

        if (field_len == 2 && strncmp(field, "id", 2) == 0) {
            if (value_len > 0 && memchr(value, 0, (size_t)value_len) != 0)
                return 0;
            self->id_len = 0;
            self->id_valid = 0;
            if (value_len > 0) {
                if (sse_push_str(&self->id_buf, &self->id_len,
                                 &self->id_cap, value, value_len) < 0)
                    return sse_set_error_code(self, 2, "out of memory");
                if (sse_terminate(&self->id_buf, &self->id_cap,
                                  self->id_len) < 0)
                    return sse_set_error_code(self, 2, "out of memory");
                self->id_valid = 1;
            }
            return 0;
        }

        if (field_len == 5 && strncmp(field, "retry", 5) == 0) {
            if (value_len == 0) return 0;
            i = 0;
            ok = 1;
            v = 0;
            while (i < value_len) {
                if (value[i] < '0' || value[i] > '9') {
                    ok = 0;
                    break;
                }
                v = v * 10 + (long)(value[i] - '0');
                if (v > 2147483647L) {
                    ok = 0;
                    break;
                }
                i = i + 1;
            }
            if (ok) {
                self->retry = (int)v;
                self->retry_valid = 1;
            }
            return 0;
        }

        return 0;
    }

    int process_line() {
        int i = 0;
        int colon = -1;
        char *field;
        char *value;
        int field_len;
        int value_len;
        int r;

        if (self->line_len == 0) return self->dispatch_event();
        if (self->line_buf[0] == ':') {
            self->line_len = 0;
            return 0;
        }
        while (i < self->line_len) {
            if (self->line_buf[i] == ':') {
                colon = i;
                break;
            }
            i = i + 1;
        }
        if (colon < 0) {
            field = self->line_buf;
            field_len = self->line_len;
            value = self->line_buf + self->line_len;
            value_len = 0;
        } else {
            field = self->line_buf;
            field_len = colon;
            value = self->line_buf + colon + 1;
            value_len = self->line_len - colon - 1;
            if (value_len > 0 && value[0] == ' ') {
                value = value + 1;
                value_len = value_len - 1;
            }
        }
        r = self->handle_field(field, field_len, value, value_len);
        self->line_len = 0;
        return r;
    }

    int consume(char c) {
        if (c == '\r') {
            self->saw_cr = 1;
            return self->process_line();
        }
        if (c == '\n') {
            if (self->saw_cr != 0) {
                self->saw_cr = 0;
                return 0;
            }
            return self->process_line();
        }
        self->saw_cr = 0;
        if (self->line_len >= self->line_limit())
            return sse_set_error_code(self, 1, "SSE line exceeds %d bytes",
                                 self->line_limit());
        if (sse_push_char(&self->line_buf, &self->line_len,
                          &self->line_cap, c) < 0)
            return sse_set_error_code(self, 2, "out of memory");
        return 0;
    }

    int replay_bom() {
        int j = 0;
        int fired = 0;
        int r;

        while (j < self->bom_len) {
            r = self->consume(self->bom_buf[j]);
            if (r < 0) return -1;
            fired = fired + r;
            j = j + 1;
        }
        self->bom_len = 0;
        self->bom_state = 3;
        return fired;
    }

    pub int on_event(SseEventCb fn, void *user) {
        if (self->reject_reentrant() < 0) return -1;
        self->cb = fn;
        self->ud = user;
        return 0;
    }

    pub int max_line_bytes(int n) {
        if (self->reject_reentrant() < 0) return -1;
        if (n < 1) return -1;
        self->max_line_bytes = n;
        return 0;
    }

    pub int feed(char *chunk, int len) {
        int i = 0;
        int fired = 0;
        int r;

        if (self->reject_reentrant() < 0) return -1;
        if (self->error) return -1;
        if (self->finished)
            return sse_set_error_code(self, 5, "parser finished");
        if (chunk == 0 || len <= 0) return 0;

        while (i < len) {
            if (self->bom_state != 3) {
                self->bom_buf[self->bom_len] = chunk[i];
                self->bom_len = self->bom_len + 1;
                if (self->bom_len == 1) {
                    if ((unsigned char)self->bom_buf[0] != 0xEF) {
                        r = self->replay_bom();
                        if (r < 0) return -1;
                        fired = fired + r;
                    }
                } else if (self->bom_len == 2) {
                    if ((unsigned char)self->bom_buf[0] != 0xEF ||
                        (unsigned char)self->bom_buf[1] != 0xBB) {
                        r = self->replay_bom();
                        if (r < 0) return -1;
                        fired = fired + r;
                    }
                } else {
                    if ((unsigned char)self->bom_buf[0] == 0xEF &&
                        (unsigned char)self->bom_buf[1] == 0xBB &&
                        (unsigned char)self->bom_buf[2] == 0xBF) {
                        self->bom_state = 3;
                        self->bom_len = 0;
                    } else {
                        r = self->replay_bom();
                        if (r < 0) return -1;
                        fired = fired + r;
                    }
                }
                i = i + 1;
                continue;
            }
            r = self->consume(chunk[i]);
            if (r < 0) return -1;
            fired = fired + r;
            i = i + 1;
        }
        return fired;
    }

    pub int finish() {
        if (self->reject_reentrant() < 0) return -1;
        if (self->error) return -1;
        if (self->finished) return -1;
        self->line_len = 0;
        self->data_len = 0;
        self->event_len = 0;
        self->has_data = 0;
        self->saw_cr = 0;
        self->bom_len = 0;
        self->bom_state = 3;
        self->finished = 1;
        return 0;
    }

    pub int has_error() {
        return self->error;
    }

    pub char *error_msg() {
        if (self->error == 0) return 0;
        return self->error_msg;
    }

    /* See sse_set_error_code for the code table. */
    pub int error_code() {
        return self->err_code;
    }

    pub char *last_event_id() {
        if (self->id_valid == 0) return 0;
        return self->id_buf;
    }

    /* A retry hint exists only after a legal `retry:` field. The value of
     * retry_hint() is undefined while has_retry() answers 0; check it first.
     * `retry: 0` is a real, set value: has_retry() == 1, retry_hint() == 0. */
    pub int has_retry() {
        return self->retry_valid;
    }

    pub int retry_hint() {
        return self->retry;
    }

    pub void reset() {
        if (self->reject_reentrant() < 0) return;
        self->line_len = 0;
        self->data_len = 0;
        self->event_len = 0;
        self->has_data = 0;
        self->saw_cr = 0;
        self->bom_state = 0;
        self->bom_len = 0;
        self->error = 0;
        self->err_code = 0;
        self->finished = 0;
        self->error_msg[0] = 0;
    }
}

static void sse_release_buffers(SseParser *p)
{
    sse_mem_free(p->line_buf);
    sse_mem_free(p->data_buf);
    sse_mem_free(p->event_buf);
    sse_mem_free(p->id_buf);
    p->line_buf = 0;
    p->data_buf = 0;
    p->event_buf = 0;
    p->id_buf = 0;
}

impl Drop for SseParser {
    void drop() {
        sse_release_buffers(self);
    }
}

pub SseParser *sse_parser_new(void)
{
    SseParser *p = sse_mem_alloc(sizeof(SseParser));
    if (p == 0) return 0;
    memset(p, 0, sizeof(SseParser));
    return p;
}

/*
 * Destruction that stays inside the allocation funnel. `delete p` also runs
 * Drop, but its final free is emitted by the compiler and therefore bypasses
 * the internal free pointer; use this function when allocations are being
 * counted or replaced.
 */
pub void sse_parser_free(SseParser *p)
{
    if (p == 0) return;
    if (p->in_callback != 0) {
        sse_set_error_code(p, 4, "reentrant call is not allowed");
        return;
    }
    sse_release_buffers(p);
    sse_mem_free(p);
}

static char *sse_dup_str(char *s)
{
    char *r;
    int n;

    if (s == 0) return 0;
    n = (int)strlen(s);
    r = sse_mem_alloc((size_t)n + 1);
    if (r == 0) return 0;
    memcpy(r, s, (size_t)n + 1);
    return r;
}

pub void sse_event_free(SseEvent *ev)
{
    if (ev == 0) return;
    sse_mem_free(ev->event);
    sse_mem_free(ev->data);
    sse_mem_free(ev->id);
    sse_mem_free(ev);
}

pub SseEvent *sse_event_copy(SseEvent *ev)
{
    SseEvent *cp;

    if (ev == 0) return 0;
    cp = sse_mem_alloc(sizeof(SseEvent));
    if (cp == 0) return 0;
    memset(cp, 0, sizeof(SseEvent));

    cp->event = sse_dup_str(ev->event);
    if (ev->event != 0 && cp->event == 0) {
        sse_event_free(cp);
        return 0;
    }
    cp->data_len = ev->data_len;
    if (ev->data != 0) {
        cp->data = sse_mem_alloc((size_t)ev->data_len + 1);
        if (cp->data == 0) {
            sse_event_free(cp);
            return 0;
        }
        memcpy(cp->data, ev->data, (size_t)ev->data_len);
        cp->data[ev->data_len] = 0;
    }
    cp->id = sse_dup_str(ev->id);
    if (ev->id != 0 && cp->id == 0) {
        sse_event_free(cp);
        return 0;
    }
    cp->retry = ev->retry;
    return cp;
}
