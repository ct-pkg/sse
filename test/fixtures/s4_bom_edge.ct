/*
 * S4 (coverage gap): only the FIRST three bytes of a stream may be a BOM.
 *
 * A BOM-looking sequence after the stream has started is ordinary content.
 * Here it becomes part of the next line's field name, which is unknown, so it
 * must produce no event. Stripping it would silently turn a junk line into a
 * valid `data:` field.
 *
 * See docs/reviews/S14-coverage.md (W9).
 */
import sse::sse;

#include <stdio.h>
#include <string.h>

static int on_ev(SseEvent *ev, void *ud)
{
    int *n = ud;
    *n = *n + 1;
    printf("e%d len=%d data=[%s]\n", *n, ev->data_len, ev->data);
    return 0;
}

static int feed_str(SseParser *p, char *s)
{
    return p->feed(s, (int)strlen(s));
}

int main(void)
{
    SseParser *p = sse::sse_parser_new();
    int n = 0;

    if (p == 0) {
        printf("new=0\n");
        return 1;
    }
    p->on_event(on_ev, &n);

    feed_str(p, "data: a\n\n");
    feed_str(p, "\xEF\xBB\xBF" "data: b\n\n");
    printf("mid_bom_events=%d\n", n);
    feed_str(p, "data: c\n\n");

    printf("n=%d err=%d\n", n, p->has_error());
    delete p;
    printf("deleted\n");
    return 0;
}
