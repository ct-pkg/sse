/*
 * S10: the event callback must not re-enter the parser.
 *
 * During a callback, feed/finish/reset/free (and other mutating methods) are
 * rejected with error code 4 and "reentrant call is not allowed"; the parser
 * keeps working after reset(). The only supported early stop is returning
 * non-zero from the callback (code 3, "callback aborted").
 */
import sse::sse;

#include <stdio.h>
#include <string.h>

struct Ctx {
    SseParser *p;
    int mode;
    int events;
    int inner_rc;
};

static int on_ev(SseEvent *ev, void *ud)
{
    struct Ctx *c = ud;

    if (ev == 0) return 1;
    c->events = c->events + 1;
    if (c->mode == 1) {
        c->inner_rc = c->p->feed("data: inner\n\n", 13);
    } else if (c->mode == 2) {
        c->p->reset();
    } else if (c->mode == 3) {
        sse::sse_parser_free(c->p);
    } else if (c->mode == 4) {
        return 1;
    }
    return 0;
}

static void report(char *tag, SseParser *p, int rc, int events)
{
    printf("%s rc=%d err=%d code=%d msg=%s events=%d\n",
           tag, rc, p->has_error(), p->error_code(),
           p->error_msg() != 0 ? p->error_msg() : "-", events);
}

int main(void)
{
    SseParser *p = sse::sse_parser_new();
    struct Ctx c;
    int rc;

    if (p == 0) {
        printf("new=0\n");
        return 1;
    }
    c.p = p;
    c.mode = 0;
    c.events = 0;
    c.inner_rc = 0;
    p->on_event(on_ev, &c);

    /* A: feed inside the callback */
    c.mode = 1;
    rc = p->feed("data: outer\n\n", 13);
    printf("inner_feed=%d\n", c.inner_rc);
    report("feed_in_cb", p, rc, c.events);
    p->reset();
    c.mode = 0;
    rc = p->feed("data: after\n\n", 13);
    report("after_feed", p, rc, c.events);

    /* B: reset inside the callback */
    c.mode = 2;
    rc = p->feed("data: outer2\n\n", 14);
    report("reset_in_cb", p, rc, c.events);
    p->reset();
    c.mode = 0;
    rc = p->feed("data: after2\n\n", 14);
    report("after_reset", p, rc, c.events);

    /* C: free inside the callback (rejected; the parser stays alive) */
    c.mode = 3;
    rc = p->feed("data: outer3\n\n", 14);
    report("free_in_cb", p, rc, c.events);
    p->reset();
    c.mode = 0;
    rc = p->feed("data: after3\n\n", 14);
    report("after_free", p, rc, c.events);

    /* D: the supported early stop is a non-zero callback return */
    c.mode = 4;
    rc = p->feed("data: outer4\n\n", 14);
    report("abort_in_cb", p, rc, c.events);
    p->reset();
    c.mode = 0;
    rc = p->feed("data: after4\n\n", 14);
    report("after_abort", p, rc, c.events);

    sse::sse_parser_free(p);
    printf("deleted\n");
    return 0;
}
