/*
 * S5 (continuation): a callback returning non-zero aborts the feed.
 * Remaining bytes are not parsed, the error text is "callback aborted", the
 * parser is terminal, and reset() alone restores it.
 */
import sse::sse;

#include <stdio.h>
#include <string.h>

static int g_abort_once = 1;

static int on_ev(SseEvent *ev, void *ud)
{
    int *n = ud;
    *n = *n + 1;
    printf("e%d data=%s\n", *n, ev->data);
    if (g_abort_once) {
        g_abort_once = 0;
        return 1;
    }
    return 0;
}

int main(void)
{
    SseParser *p = sse::sse_parser_new();
    char *two = "data: one\n\ndata: two\n\n";
    char *four = "data: four\n\n";
    int n = 0;
    int rc;

    if (p == 0) {
        printf("new=0\n");
        return 1;
    }
    p->on_event(on_ev, &n);

    rc = p->feed(two, (int)strlen(two));
    printf("feed=%d n=%d err=%d msg=%s\n", rc, n, p->has_error(),
           p->error_msg());

    rc = p->feed(four, (int)strlen(four));
    printf("after=%d n=%d\n", rc, n);

    p->reset();
    rc = p->feed(four, (int)strlen(four));
    printf("feed2=%d n=%d err=%d\n", rc, n, p->has_error());

    delete p;
    printf("deleted\n");
    return 0;
}
